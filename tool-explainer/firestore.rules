rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios con sesión iniciada pueden leer/escribir los datos de TallerScan.
    match /tallerscan/{doc} {
      allow read, write: if request.auth != null;

      // Opción más estricta (lista blanca de correos): reemplaza la línea de arriba por:
      // allow read, write: if request.auth != null
      //   && request.auth.token.email in ['correo1@ejemplo.com', 'correo2@ejemplo.com'];
    }

    // Todo lo demás, bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
